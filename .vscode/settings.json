{
  // One tool decides the order of imports and exports: ESLint (simple-import-sort). VS Code's own
  // "Organize Imports" sorts differently (type names last, case rules of its own), so on every
  // Ctrl+S it undid ESLint's order and lint failed. Keep it off here. "Remove Unused Imports" is
  // fine: it only deletes unused imports and leaves the order alone.
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.removeUnusedImports": "always",
    "source.fixAll.eslint": "always"
  },
  // The root eslint.config.js ignores packages/, frontend/ and backend/ (each lints itself), so the
  // extension must look for the nearest config of the file being saved.
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // VS Code downloads a JSON schema only from trusted domains; the apps' vercel.json use Vercel's
  // (its own defaults stay trusted: object settings merge)
  "json.schemaDownload.trustedDomains": { "https://openapi.vercel.sh/": true },
  "cSpell.words": [
    "bqtestidotp",
    "bqtestnotify",
    "Brevo",
    "bullmq",
    "colour",
    "COLOURS",
    "deployables",
    "dsphere",
    "hgetall",
    "hset",
    "mailin",
    "mailpit",
    "meera",
    "pttl",
    "rediss",
    "redrive",
    "resends",
    "riya",
    "superadmin",
    "THREADPOOL",
    "uuidv",
    "Valkey"
  ]
}
