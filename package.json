{
  "name": "beautinique",
  "private": true,
  "description": "Beautinique monorepo: shared packages, frontend apps and backend services.",
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*/*",
    "frontend/*",
    "backend/*",
    "scripts/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "secrets:scan": "gitleaks git --config .gitleaks.toml --redact ."
  },
  "engines": {
    "node": "24.22.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.3",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.2.3",
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
