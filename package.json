{
  "name": "beautinique",
  "private": true,
  "description": "Beautinique monorepo: packages, frontend apps and backend services.",
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "login": "node scripts/packages/bin/login.ts",
    "logout": "node scripts/packages/bin/logout.ts",
    "status": "node scripts/packages/bin/status.ts",
    "create": "node scripts/packages/bin/create.ts",
    "publish": "node scripts/packages/bin/publish.ts",
    "republish": "node scripts/packages/bin/republish.ts",
    "verify": "node scripts/packages/bin/verify.ts",
    "build": "node scripts/packages/bin/build.ts",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "typecheck": "tsc -p scripts && npm run typecheck --workspaces --if-present",
    "test": "vitest run --config scripts/vitest.config.ts && npm run test --workspaces --if-present",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
