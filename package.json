{
  "name": "beautinique",
  "private": true,
  "description": "Beautinique monorepo: shared packages, frontend apps and backend services.",
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*/*",
    "frontend/*",
    "backend/*",
    "scripts/*"
  ],
  "scripts": {
    "setup": "node scripts/foundation/bin/setup.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.js configs .github/scripts",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "infra:up": "node scripts/foundation/bin/infra.ts up",
    "infra:down": "node scripts/foundation/bin/infra.ts down",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "secrets:scan": "gitleaks git --config .gitleaks.toml --redact ."
  },
  "engines": {
    "node": "24.22.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.3",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.2.3",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
