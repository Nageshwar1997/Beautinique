{
  "name": "beautinique",
  "private": true,
  "description": "Beautinique monorepo: packages, frontend apps and backend services.",
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*/*",
    "frontend/*",
    "backend/*"
  ],
  "scripts": {
    "login": "node scripts/packages/bin/login.ts",
    "logout": "node scripts/packages/bin/logout.ts",
    "status": "node scripts/packages/bin/status.ts",
    "create": "node scripts/packages/bin/create.ts",
    "mutate": "node scripts/mutation/bin/mutate.ts",
    "create:app": "node scripts/packages/bin/create.ts --type app",
    "create:backend": "node scripts/packages/bin/create.ts --type backend",
    "publish": "node scripts/packages/bin/publish.ts",
    "republish": "node scripts/packages/bin/republish.ts",
    "verify": "node scripts/packages/bin/verify.ts",
    "build": "node scripts/packages/bin/build.ts",
    "dev:backend": "npm run dev --workspace bundle",
    "infra:up": "docker compose -f infra/docker-compose.yml up --detach --wait --wait-timeout 180",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down --volumes",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs --follow",
    "infra:mutation:up": "docker compose -f infra/docker-compose.yml --profile mutation up --detach --wait --wait-timeout 180 mongo-mutation valkey-mutation",
    "infra:mutation:down": "docker compose -f infra/docker-compose.yml --profile mutation rm --stop --force mongo-mutation valkey-mutation",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "typecheck": "tsc -p scripts && npm run typecheck --workspaces --if-present",
    "test": "vitest run --config scripts/vitest.config.ts && npm run test --workspaces --if-present",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.4",
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "helmet": "^8.3.0",
    "isbot": "^5.2.2",
    "jsdom": "^30.1.3",
    "pino": "^10.4.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
