    "beautinique",
    "shared",
    "authz",
    "permissions",
    "rbac",
    "scopes"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/shared/authz"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/shared/authz#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
