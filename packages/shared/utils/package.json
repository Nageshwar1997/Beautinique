{
  "name": "@beautinique/shared-utils",
  "version": "2.0.0",
  "description": "Beautinique helpers: money in paise (INR formatting, GST, discounts, exact splits), IST dates, masking, slugs and UUIDv7.",
  "keywords": [
    "beautinique",
    "shared",
    "utils",
    "money",
    "inr",
    "gst",
    "dates",
    "uuidv7"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/shared/utils"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/shared/utils#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
