{
  "name": "@beautinique/shared-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Beautinique API contracts: routes, events, permissions, error codes and area settings, declared once with zod; OpenAPI and gateway manifest from them.",
  "keywords": [
    "beautinique",
    "shared",
    "contracts",
    "api",
    "events",
    "openapi",
    "zod"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/shared/contracts"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/shared/contracts#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@beautinique/shared-zod": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
