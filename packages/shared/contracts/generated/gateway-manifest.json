{
  "version": "1.0.0",
  "routes": [
    {
      "id": "platform.ping.record",
      "method": "POST",
      "path": "/platform/pings",
      "owner": "core",
      "apps": [
        "customer",
        "seller",
        "admin",
        "superadmin",
        "master",
        "support",
        "finance",
        "logistics",
        "delivery",
        "growth",
        "creator"
      ],
      "access": {
        "type": "public"
      },
      "rateLimit": "write",
      "idempotency": true,
      "stepUp": false,
      "cache": null
    },
    {
      "id": "platform.ping.get",
      "method": "GET",
      "path": "/platform/pings/:pingId",
      "owner": "core",
      "apps": [
        "admin",
        "superadmin",
        "master"
      ],
      "access": {
        "type": "permission",
        "permission": "platform.ping.read"
      },
      "rateLimit": "read",
      "idempotency": false,
      "stepUp": false,
      "cache": null
    },
    {
      "id": "platform.server.wake",
      "method": "GET",
      "path": "/platform/wake",
      "owner": "core",
      "apps": [
        "customer",
        "seller",
        "admin",
        "superadmin",
        "master",
        "support",
        "finance",
        "logistics",
        "delivery",
        "growth",
        "creator"
      ],
      "access": {
        "type": "public"
      },
      "rateLimit": "public",
      "idempotency": false,
      "stepUp": false,
      "cache": null
    },
    {
      "id": "auth.otp.request",
      "method": "POST",
      "path": "/auth/otp",
      "owner": "identity",
      "apps": [
        "customer",
        "seller",
        "creator",
        "delivery"
      ],
      "access": {
        "type": "public"
      },
      "rateLimit": "otp",
      "idempotency": false,
      "stepUp": false,
      "cache": null
    },
    {
      "id": "auth.otp.resend",
      "method": "POST",
      "path": "/auth/otp/:challengeId/resend",
      "owner": "identity",
      "apps": [
        "customer",
        "seller",
        "creator",
        "delivery"
      ],
      "access": {
        "type": "public"
      },
      "rateLimit": "otp",
      "idempotency": false,
      "stepUp": false,
      "cache": null
    },
    {
      "id": "auth.otp.verify",
      "method": "POST",
      "path": "/auth/otp/:challengeId/verify",
      "owner": "identity",
      "apps": [
        "customer",
        "seller",
        "creator",
        "delivery"
      ],
      "access": {
        "type": "public"
      },
      "rateLimit": "auth",
      "idempotency": false,
      "stepUp": false,
      "cache": null
    }
  ]
}
