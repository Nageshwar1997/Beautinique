{
  "name": "@beautinique/backend-server-crypto",
  "version": "1.0.0",
  "description": "Beautinique field encryption: AES-256-GCM sealed values bound to their record, versioned keys for rotation, HMAC blind indexes for lookups and masked copies for display.",
  "keywords": [
    "beautinique",
    "backend",
    "encryption",
    "aes-gcm",
    "blind-index",
    "pii"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/backend/server-crypto"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/backend/server-crypto#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
