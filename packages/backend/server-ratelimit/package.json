{
  "name": "@beautinique/backend-server-ratelimit",
  "version": "1.0.0",
  "description": "Redis rate limits for Beautinique services: GCRA buckets in one Lua call, with a timeout so a slow Redis never holds a request.",
  "keywords": [
    "beautinique",
    "backend",
    "rate-limit",
    "redis",
    "gcra"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/backend/server-ratelimit"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/backend/server-ratelimit#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
