{
  "name": "@beautinique/backend-server-storage",
  "version": "1.0.0",
  "description": "Beautinique file storage port: one interface for signed uploads, URLs, copy, delete and listing, plus an in-memory adapter and contract tests every provider adapter must pass.",
  "keywords": [
    "beautinique",
    "backend",
    "storage",
    "files",
    "assets",
    "upload"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/backend/server-storage"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/backend/server-storage#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@beautinique/shared-utils": "^2.0.0",
    "@beautinique/shared-zod": "^2.0.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
