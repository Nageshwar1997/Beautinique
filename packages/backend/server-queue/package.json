{
  "name": "@beautinique/backend-server-queue",
  "version": "1.0.0",
  "description": "Beautinique events: one Redis connection per deployable, the transactional outbox and its relay to BullMQ (poll or change stream, behind a Mongo lease lock).",
  "keywords": [
    "beautinique",
    "backend",
    "outbox",
    "bullmq",
    "redis",
    "relay"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/backend/server-queue"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/backend/server-queue#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@beautinique/backend-server-kit": "^1.0.0",
    "@beautinique/backend-server-mongo": "^1.0.0",
    "@beautinique/shared-contracts": "^1.0.0"
  },
  "dependencies": {
    "@beautinique/shared-utils": "^2.0.0",
    "bullmq": "^6.4.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@beautinique/backend-server-kit": "^1.0.0",
    "@beautinique/backend-server-mongo": "^1.0.0",
    "@beautinique/shared-contracts": "^1.0.0",
    "@beautinique/shared-zod": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
