{
  "name": "@beautinique/frontend-icons",
  "version": "1.0.0",
  "description": "Beautinique's own icon components: SVG copied from Iconify sets (only the icons we use), one BaseIcon, no runtime Iconify.",
  "keywords": [
    "beautinique",
    "frontend",
    "icons",
    "react",
    "svg"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/frontend/icons"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/frontend/icons#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint .",
    "test": "vitest run",
    "playground": "vite playground",
    "add-icons": "node scripts/add-icons.ts"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@beautinique/frontend-styles": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
