{
  "name": "@beautinique/frontend-app-shell",
  "version": "1.0.0",
  "description": "The frame every Beautinique app shares: skip link, header and footer slots, theme switcher without a flash, nav list and error pages. Each app brings its own header and footer.",
  "keywords": [
    "beautinique",
    "frontend",
    "react",
    "layout",
    "theme",
    "accessibility"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/frontend/app-shell"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/frontend/app-shell#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "playground": "vite playground"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "dependencies": {
    "@beautinique/frontend-icons": "^1.0.0"
  },
  "devDependencies": {
    "@beautinique/frontend-styles": "^2.0.0",
    "@beautinique/shared-contracts": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
