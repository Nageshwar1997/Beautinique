{
  "name": "@beautinique/frontend-api-client",
  "version": "1.0.0",
  "description": "The typed API client of the Beautinique apps: contract routes, one refresh at a time, step-up, idempotency keys and TanStack Query hooks.",
  "keywords": [
    "beautinique",
    "frontend",
    "api",
    "client",
    "tanstack-query",
    "auth"
  ],
  "author": "Nageshwar Pawar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nageshwar1997/Beautinique.git",
    "directory": "packages/frontend/api-client"
  },
  "homepage": "https://github.com/Nageshwar1997/Beautinique/tree/main/packages/frontend/api-client#readme",
  "bugs": {
    "url": "https://github.com/Nageshwar1997/Beautinique/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@beautinique/frontend-hooks": "^2.0.0",
    "@beautinique/shared-contracts": "^1.0.0",
    "axios": "^1.21.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@beautinique/shared-zod": "^2.0.0",
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
