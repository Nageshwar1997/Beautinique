# core settings: CORE__<SETTING>, namespaced so backend/bundle can run every deployable in one
# process (ARCHITECTURE §3). Only src/config.ts reads them.
#
# Three parts:
#   LOCAL       what core alone needs on the laptop (npm run dev --workspace core). Your
#               backend/core/.env is this part: copy it. Public laptop values, never secrets.
#   OPTIONAL    settings with a default: set one only to change it.
#   PRODUCTION  dummy values (<...> = the real one). Live runs backend/bundle: the real values go in
#               Render and your private backend/bundle/.env.production, never here.

# ═══ LOCAL (your .env) ══════════════════════════════════════════════════════════════════════════
# MongoDB: the laptop's replica set (npm run infra:up)
CORE__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# Redis for the queues: the laptop's Valkey
CORE__REDIS_URL=redis://localhost:6379

# ═══ OPTIONAL (defaults) ════════════════════════════════════════════════════════════════════════
# CORE__PORT=8084
# CORE__LOG_LEVEL=info                         fatal, error, warn, info, debug, trace or silent
# CORE__MONGO_DB_NAME=bq_core                  core's own database; no other deployable uses it
# CORE__OUTBOX_RELAY=poll                      poll (Atlas free) or changestream (a replica set you run)

# ═══ PRODUCTION (Render; dummy values) ══════════════════════════════════════════════════════════
# CORE__MONGO_URI=mongodb+srv://bq-core:<password>@<cluster-host>/?retryWrites=true&w=majority
#                                              (Atlas user bq-core, readWrite on bq_core only)
# CORE__REDIS_URL=redis://<bq-live-kv-internal-host>:6379         (Render Key Value, internal URL)
