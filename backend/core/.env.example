# core settings: CORE__<SETTING>, namespaced so backend/bundle can run every deployable in
# one process (ARCHITECTURE §3). Copy this file to .env for local runs. Never commit .env.
CORE__PORT=8084
# fatal, error, warn, info, debug, trace or silent
CORE__LOG_LEVEL=info
# MongoDB: the laptop's replica set (npm run infra:up). Live: the connection string from Atlas.
CORE__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# core's own database; no other deployable reads or writes it
CORE__MONGO_DB_NAME=bq_core
# Redis for the queues: Docker Valkey on the laptop. Live: Render Key Value, internal URL only.
CORE__REDIS_URL=redis://localhost:6379
# poll (Atlas free) or changestream (a replica set you run)
CORE__OUTBOX_RELAY=poll
