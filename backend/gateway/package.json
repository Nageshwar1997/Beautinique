{
  "name": "gateway",
  "version": "0.0.0",
  "private": true,
  "description": "The one public entry: checks the app, finds the route and streams it to the deployable that owns it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/service.ts",
      "beautinique-source": "./src/service.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@beautinique/backend-server-crypto": "^1.0.0",
    "@beautinique/backend-server-kit": "^1.0.0",
    "@beautinique/backend-server-mongo": "^1.0.0",
    "@beautinique/backend-server-queue": "^1.0.0",
    "@beautinique/backend-server-ratelimit": "^1.0.0",
    "@beautinique/shared-contracts": "^1.0.0",
    "@beautinique/shared-zod": "^2.0.0",
    "axios": "^1.21.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
