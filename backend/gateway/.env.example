# gateway settings: GATEWAY__<SETTING>, namespaced so backend/bundle can run every deployable in one
# process (ARCHITECTURE §3). Only src/config.ts reads them.
#
# Three parts:
#   LOCAL       what the gateway alone needs on the laptop (npm run dev --workspace gateway), next to
#               the other deployables run alone. Your backend/gateway/.env is this part: copy it.
#               Public laptop values, never secrets.
#   OPTIONAL    settings with a default: set one only to change it.
#   PRODUCTION  dummy values (<...> = the real one). Live runs backend/bundle (it gives the gateway the
#               upstream URLs itself): the real values go in Render and your private
#               backend/bundle/.env.production, never here.

# ═══ LOCAL (your .env) ══════════════════════════════════════════════════════════════════════════
# Origin of each deployable behind the gateway; one left out answers 503
GATEWAY__IDENTITY_URL=http://127.0.0.1:8081
GATEWAY__PAYMENTS_URL=http://127.0.0.1:8082
GATEWAY__NOTIFY_URL=http://127.0.0.1:8083
GATEWAY__CORE_URL=http://127.0.0.1:8084
# Redis for the rate limits: the laptop's Valkey (npm run infra:up)
GATEWAY__REDIS_URL=redis://localhost:6379
# x-origin-secret that every app's /api route sends (ARCHITECTURE §7.2), comma-separated (the current
# one, and during a rotation the old one too; 32+ characters each). Public laptop value: the dev
# servers send it by default.
GATEWAY__ORIGIN_SECRETS=not-a-secret-not-a-secret-not-a-secret
# Hosts of each app (<app>=<host>, comma-separated): the dev servers
GATEWAY__APP_HOSTS=customer=localhost:3001,seller=localhost:3002,admin=localhost:3003,superadmin=localhost:3004,master=localhost:3005,support=localhost:3006,finance=localhost:3007,logistics=localhost:3008,delivery=localhost:3009,growth=localhost:3010,creator=localhost:3011

# ═══ OPTIONAL (defaults) ════════════════════════════════════════════════════════════════════════
# GATEWAY__PORT=8080
# GATEWAY__LOG_LEVEL=info                      fatal, error, warn, info, debug, trace or silent
# GATEWAY__UPSTREAM_TIMEOUT_MS=30000           an upstream silent this long gets a 504
# GATEWAY__RATE_LIMITS=                        budgets that differ from src/rate-limits.ts, e.g. write=20/1m,otp=5/15m
# GATEWAY__VERCEL_PROJECTS=                    Vercel preview hosts: empty on the laptop
# GATEWAY__VERCEL_SCOPE=

# ═══ PRODUCTION (Render; dummy values) ══════════════════════════════════════════════════════════
# GATEWAY__REDIS_URL=redis://<bq-live-kv-internal-host>:6379      (Render Key Value bq-live-kv, internal URL)
# GATEWAY__ORIGIN_SECRETS=<random-32-bytes-base64url>             (the same as ORIGIN_SECRET in every Vercel project)
#   make it with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# GATEWAY__APP_HOSTS=customer=bq-customer.vercel.app              (each Vercel project's production host)
# GATEWAY__VERCEL_PROJECTS=customer=bq-customer                   (preview hosts <project>-git-<branch>-<scope>.vercel.app)
# GATEWAY__VERCEL_SCOPE=<vercel-scope-slug>
