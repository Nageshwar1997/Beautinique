# gateway settings: GATEWAY__<SETTING>, namespaced so backend/bundle can run every deployable in
# one process (ARCHITECTURE §3). Copy this file to .env for local runs. Never commit .env.
GATEWAY__PORT=8080
# fatal, error, warn, info, debug, trace or silent
GATEWAY__LOG_LEVEL=info

# Origin of each deployable behind the gateway. Empty = not running: its routes answer 503.
# (backend/bundle passes the URLs of its own internal servers instead.)
GATEWAY__IDENTITY_URL=http://127.0.0.1:8081
GATEWAY__PAYMENTS_URL=http://127.0.0.1:8082
GATEWAY__NOTIFY_URL=http://127.0.0.1:8083
GATEWAY__CORE_URL=http://127.0.0.1:8084
# An upstream that sends nothing back for this many milliseconds gets a 504
GATEWAY__UPSTREAM_TIMEOUT_MS=30000

# Redis for the rate limits: the laptop's Valkey (npm run infra:up); live, Render Key Value's internal URL
GATEWAY__REDIS_URL=redis://localhost:6379

# x-origin-secret that every app's /api route sends (ARCHITECTURE §7.2), comma-separated: the current one,
# and during a rotation the old one too; 32+ characters each. This value is for the laptop only and is
# public: the dev servers send it by default. Live gets its own, made with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# and set in Render and in every Vercel project (ORIGIN_SECRET, Sensitive).
GATEWAY__ORIGIN_SECRETS=not-a-secret-not-a-secret-not-a-secret

# Hosts of each app (<app>=<host>, comma-separated): the dev servers here; live, each Vercel project's
# production host, e.g. customer=bq-customer.vercel.app
GATEWAY__APP_HOSTS=customer=localhost:3001,seller=localhost:3002,admin=localhost:3003,superadmin=localhost:3004,master=localhost:3005,support=localhost:3006,finance=localhost:3007,logistics=localhost:3008,delivery=localhost:3009,growth=localhost:3010,creator=localhost:3011
# Vercel preview hosts (<project>-git-<branch>-<scope>.vercel.app): each app's Vercel project and the
# account's scope slug. Empty locally.
GATEWAY__VERCEL_PROJECTS=
GATEWAY__VERCEL_SCOPE=

# Rate-limit budgets that differ from the defaults (src/rate-limits.ts), e.g. write=20/1m,otp=5/15m
GATEWAY__RATE_LIMITS=
