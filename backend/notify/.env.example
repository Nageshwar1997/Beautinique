# notify settings: NOTIFY__<SETTING>, namespaced so backend/bundle can run every deployable in one
# process (ARCHITECTURE §3). Only src/config.ts reads them.
#
# Three parts:
#   LOCAL       what notify alone needs on the laptop (npm run dev --workspace notify). Your
#               backend/notify/.env is this part: copy it. Public laptop values, never secrets.
#   OPTIONAL    settings with a default: set one only to change it.
#   PRODUCTION  dummy values (<...> = the real one). Live runs backend/bundle: the real values go in
#               Render and your private backend/bundle/.env.production, never here.

# ═══ LOCAL (your .env) ══════════════════════════════════════════════════════════════════════════
# MongoDB: the laptop's replica set (npm run infra:up)
NOTIFY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# Redis: the laptop's Valkey
NOTIFY__REDIS_URL=redis://localhost:6379
# Who delivers email: mailpit on the laptop (inbox at http://localhost:8025). No default, so live never
# falls back to Mailpit.
NOTIFY__EMAIL_TRANSPORT=mailpit
NOTIFY__EMAIL_FROM=no-reply@beautinique.example
# Opens the sign-in code in identity.otp.requested: exactly the value of IDENTITY__OTP_EVENT_KEYS.
# Public laptop key (32 zero bytes).
NOTIFY__OTP_EVENT_KEYS=e1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ═══ OPTIONAL (defaults) ════════════════════════════════════════════════════════════════════════
# NOTIFY__PORT=8083
# NOTIFY__LOG_LEVEL=info                       fatal, error, warn, info, debug, trace or silent
# NOTIFY__MONGO_DB_NAME=bq_notify              notify's own database; no other deployable uses it
# NOTIFY__MAILPIT_URL=http://localhost:8025    the Mailpit HTTP API (infra/docker-compose.yml)
# NOTIFY__EMAIL_FROM_NAME=Beautinique
# NOTIFY__EMAIL_DAILY_LIMIT=300                Brevo free: 300 emails a day in all
# NOTIFY__EMAIL_OTHER_LIMIT=250                after this many, only sign-in codes and transactional emails
# NOTIFY__APP_URLS=customer=http://localhost:3001,admin=http://localhost:3003   links in emails; an app left out: no link

# ═══ PRODUCTION (Render; dummy values) ══════════════════════════════════════════════════════════
# NOTIFY__MONGO_URI=mongodb+srv://bq-notify:<password>@<cluster>.mongodb.net/?appName=Beautinique
#                                              (Atlas user bq-notify, readWrite on bq_notify only)
# NOTIFY__REDIS_URL=redis://<bq-live-kv-internal-host>:6379       (Render Key Value, internal URL)
# NOTIFY__EMAIL_TRANSPORT=brevo                                   (Brevo's HTTPS API; Render blocks SMTP)
# NOTIFY__BREVO_API_KEY=<brevo-api-key>                           (Brevo → SMTP & API → API keys)
# NOTIFY__EMAIL_FROM=<sender-verified-in-brevo>                   (Senders, domains & dedicated IPs → Senders)
# NOTIFY__OTP_EVENT_KEYS=e1:<random-32-bytes-base64>              (exactly the same as IDENTITY__OTP_EVENT_KEYS)
# NOTIFY__APP_URLS=customer=https://<customer-vercel-host>        (optional: links in invitation emails; add each app once it is live)
