# notify settings: NOTIFY__<SETTING>, namespaced so backend/bundle can run every deployable in
# one process (ARCHITECTURE §3). Laptop: copy this file to .env (never committed). Live runs these
# keys in backend/bundle: their live values go in Render and in your private backend/bundle/.env.production.
NOTIFY__PORT=8083
# fatal, error, warn, info, debug, trace or silent
NOTIFY__LOG_LEVEL=info
# MongoDB: the laptop's replica set (npm run infra:up). Live: the Atlas connection string of the
# bq-notify database user (readWrite on bq_notify only).
NOTIFY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# notify's own database; no other deployable reads or writes it
NOTIFY__MONGO_DB_NAME=bq_notify
# Redis: Docker Valkey on the laptop. Live: Render Key Value, internal URL only.
NOTIFY__REDIS_URL=redis://localhost:6379
# Who delivers email: mailpit on the laptop (inbox at http://localhost:8025), brevo live (HTTPS API;
# Render blocks SMTP). No default, so live never falls back to Mailpit.
NOTIFY__EMAIL_TRANSPORT=mailpit
# Live only: the Brevo API key (Brevo → SMTP & API → API keys). Secret: Render only, never here.
NOTIFY__BREVO_API_KEY=
# The Mailpit HTTP API (infra/docker-compose.yml)
NOTIFY__MAILPIT_URL=http://localhost:8025
# The sender. Live: the sender address verified in Brevo (Senders, domains & dedicated IPs → Senders).
NOTIFY__EMAIL_FROM=no-reply@beautinique.example
NOTIFY__EMAIL_FROM_NAME=Beautinique
# Opens the sign-in code in identity.otp.requested: exactly the same value as IDENTITY__OTP_EVENT_KEYS.
# `id:base64` (32 random bytes); several comma-separated while a key rotates (the first seals).
# This laptop key (32 zero bytes) is public, never use it live. Live: a new one, made with
#   node -e "console.log('e1:' + require('node:crypto').randomBytes(32).toString('base64'))"
NOTIFY__OTP_EVENT_KEYS=e1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Brevo free: 300 emails a day in all; after 250, only sign-in codes and transactional emails
NOTIFY__EMAIL_DAILY_LIMIT=300
NOTIFY__EMAIL_OTHER_LIMIT=250
