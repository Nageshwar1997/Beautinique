# backend/bundle runs every deployable in one process (ARCHITECTURE §3): the Render live server `bq-live`.
# Each deployable reads only its own <NAME>__* keys from the same env, so all of them are here, grouped
# per deployable in the order of ARCHITECTURE §3 (backend/<name>/.env.example explains each one).
#
# Three parts:
#   LOCAL       only what the laptop needs (npm run dev:backend, npm run db:release). Your .env is
#               this part: copy it. The values are public laptop values, never secrets.
#   OPTIONAL    settings with a default: set one only to change it (laptop or live).
#   PRODUCTION  what Render needs, with dummy values: <...> is a placeholder for the real value. The
#               real ones go in Render's dashboard and in your private .env.production
#               (only `npm run db:release -- --env live` reads that file, after you type live).
# (.gitignore keeps every .env* out of git except .env.example. No secret in this file, ever.)

# ═══ LOCAL (your .env) ══════════════════════════════════════════════════════════════════════════

# ── gateway ──
GATEWAY__REDIS_URL=redis://localhost:6379
# x-origin-secret of the apps' /api routes: this laptop value is public, the dev servers send it
GATEWAY__ORIGIN_SECRETS=not-a-secret-not-a-secret-not-a-secret
GATEWAY__APP_HOSTS=customer=localhost:3001,seller=localhost:3002,admin=localhost:3003,superadmin=localhost:3004,master=localhost:3005,support=localhost:3006,finance=localhost:3007,logistics=localhost:3008,delivery=localhost:3009,growth=localhost:3010,creator=localhost:3011

# ── identity ──
IDENTITY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
IDENTITY__REDIS_URL=redis://localhost:6379
# public laptop keys (32 bytes of 1s, of 2s, of 0s); the OTP key is the same as notify's
IDENTITY__FIELD_KEYS=k1:AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
IDENTITY__BLIND_INDEX_KEY=b1:AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
IDENTITY__OTP_EVENT_KEYS=e1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── notify ──
NOTIFY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
NOTIFY__REDIS_URL=redis://localhost:6379
# emails go to Mailpit: http://localhost:8025
NOTIFY__EMAIL_TRANSPORT=mailpit
NOTIFY__EMAIL_FROM=no-reply@beautinique.example
NOTIFY__OTP_EVENT_KEYS=e1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── core ──
CORE__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
CORE__REDIS_URL=redis://localhost:6379

# ═══ OPTIONAL (defaults; set one only to change it) ═════════════════════════════════════════════
# bundle:   PORT=8080 (Render sets it itself), SENTRY_DSN= (empty = Sentry off), SENTRY_ENVIRONMENT=
#           (live: Render's RENDER=true makes it `live`; elsewhere `development`)
# gateway:  GATEWAY__LOG_LEVEL=info, GATEWAY__UPSTREAM_TIMEOUT_MS=30000,
#           GATEWAY__RATE_LIMITS= (budgets that differ from src/rate-limits.ts, e.g. write=20/1m)
#           (bundle mode gives the gateway its upstream URLs and port itself)
# identity: IDENTITY__LOG_LEVEL=info, IDENTITY__MONGO_DB_NAME=bq_identity, IDENTITY__OUTBOX_RELAY=poll,
#           IDENTITY__OTP_EMAIL_LIMIT_PER_HOUR=5, IDENTITY__LEGAL_VERSION=dummy-1
# notify:   NOTIFY__LOG_LEVEL=info, NOTIFY__MONGO_DB_NAME=bq_notify, NOTIFY__MAILPIT_URL=http://localhost:8025,
#           NOTIFY__EMAIL_FROM_NAME=Beautinique, NOTIFY__EMAIL_DAILY_LIMIT=300, NOTIFY__EMAIL_OTHER_LIMIT=250
# core:     CORE__LOG_LEVEL=info, CORE__MONGO_DB_NAME=bq_core, CORE__OUTBOX_RELAY=poll

# ═══ PRODUCTION (Render; dummy values, <...> = the real value) ══════════════════════════════════

# ── bundle ──
# NODE_VERSION=24
# UV_THREADPOOL_SIZE=2                     (the 0.1 CPU free instance, ARCHITECTURE §11.1)
# SENTRY_DSN=https://<public-key>@<org-id>.ingest.<region>.sentry.io/<project-id>   (Sentry project bq-backend)
# Never set NODE_ENV=production on Render: the build then skips devDependencies. PORT: Render sets it.

# ── gateway ──
# GATEWAY__REDIS_URL=redis://<bq-live-kv-internal-host>:6379        (Render Key Value bq-live-kv, internal URL)
# GATEWAY__ORIGIN_SECRETS=<random-32-bytes-base64url>                (the same as ORIGIN_SECRET in Vercel)
# GATEWAY__APP_HOSTS=customer=bq-customer.vercel.app                 (more apps as they go live)
# GATEWAY__VERCEL_PROJECTS=customer=bq-customer                      (Vercel preview hosts)
# GATEWAY__VERCEL_SCOPE=<vercel-scope-slug>
#   make a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# ── identity ──
# IDENTITY__MONGO_URI=mongodb+srv://bq-identity:<password>@<cluster>.mongodb.net/?appName=Beautinique
# IDENTITY__REDIS_URL=redis://<bq-live-kv-internal-host>:6379
# IDENTITY__FIELD_KEYS=k1:<random-32-bytes-base64>
# IDENTITY__BLIND_INDEX_KEY=b1:<another-random-32-bytes-base64>
# IDENTITY__OTP_EVENT_KEYS=e1:<random-32-bytes-base64>               (exactly the same as NOTIFY__OTP_EVENT_KEYS)
#   make a key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

# ── notify ──
# NOTIFY__MONGO_URI=mongodb+srv://bq-notify:<password>@<cluster>.mongodb.net/?appName=Beautinique
# NOTIFY__REDIS_URL=redis://<bq-live-kv-internal-host>:6379
# NOTIFY__EMAIL_TRANSPORT=brevo
# NOTIFY__BREVO_API_KEY=<brevo-api-key>                              (Brevo → SMTP & API → API keys)
# NOTIFY__EMAIL_FROM=<sender-verified-in-brevo>
# NOTIFY__OTP_EVENT_KEYS=e1:<random-32-bytes-base64>                 (exactly the same as IDENTITY__OTP_EVENT_KEYS)

# ── core ──
# CORE__MONGO_URI=mongodb+srv://bq-core:<password>@<cluster>.mongodb.net/?appName=Beautinique
# CORE__REDIS_URL=redis://<bq-live-kv-internal-host>:6379
