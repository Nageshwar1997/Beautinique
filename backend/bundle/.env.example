# backend/bundle runs every deployable in one process (ARCHITECTURE §3): the Render live server `bq-live`.
# Each deployable reads its own <NAME>__* keys from the same env, so they all go here
# (backend/<name>/.env.example explains each one).
#
# Three files, the same keys:
#   .env.example     this file, in git: the laptop's values and what live needs. No secret, ever.
#   .env             your laptop (npm run dev:backend reads it). Copy this file. Never committed.
#   .env.production  your private copy of the live values you set in Render. Never committed, and
#                    nothing reads it: the live server takes its env from Render's dashboard.
# (.gitignore keeps every .env* out of git except .env.example.)

# The public port. Live: not set, Render sets PORT itself.
PORT=8080

# Sentry for the whole process (src/instrument.ts, preloaded with node --import). Empty = off, which is
# right for the laptop. Live: the DSN of the Sentry project bq-backend.
SENTRY_DSN=
# Live: not set (Render sets RENDER=true, so it is `live`); elsewhere `development`.
SENTRY_ENVIRONMENT=

# MongoDB. Live: the Atlas connection string (mongodb+srv, Atlas → Connect → Drivers), each with its
# own database user: bq-core (readWrite on bq_core), bq-identity (readWrite on bq_identity).
CORE__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
IDENTITY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# Redis for the queues and the rate limits. Live: the internal URL of Render Key Value bq-live-kv,
# all keys the same (production Redis is never used from a laptop or a test).
CORE__REDIS_URL=redis://localhost:6379
IDENTITY__REDIS_URL=redis://localhost:6379
GATEWAY__REDIS_URL=redis://localhost:6379
# x-origin-secret of the apps' /api routes (ARCHITECTURE §7.2). This laptop value is public: the dev
# servers send it by default. Live: a random secret, the same as ORIGIN_SECRET in Vercel, made with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GATEWAY__ORIGIN_SECRETS=not-a-secret-not-a-secret-not-a-secret
# Hosts of each app. Live: customer=bq-customer.vercel.app (more as apps go live).
GATEWAY__APP_HOSTS=customer=localhost:3001,seller=localhost:3002,admin=localhost:3003,superadmin=localhost:3004,master=localhost:3005,support=localhost:3006,finance=localhost:3007,logistics=localhost:3008,delivery=localhost:3009,growth=localhost:3010,creator=localhost:3011
# Vercel preview hosts. Laptop: empty. Live: customer=bq-customer and nageshwar-pawars-projects.
GATEWAY__VERCEL_PROJECTS=
GATEWAY__VERCEL_SCOPE=

# Live only, in Render (not needed on the laptop):
#   NODE_VERSION=24          Render's Node
#   UV_THREADPOOL_SIZE=2     the 0.1 CPU free instance (ARCHITECTURE §11.1)
# Never set NODE_ENV=production on Render: the build then skips devDependencies.
