# backend/bundle runs every deployable in one process (ARCHITECTURE §3). Copy this file to .env for
# local runs; never commit .env. Each deployable reads its own <NAME>__* keys from the same env, so
# put them here too (see backend/<name>/.env.example).
# The public port (Render sets PORT itself, plus UV_THREADPOOL_SIZE=2 in its environment, §11.1)
PORT=8080

# Sentry for the whole process (src/instrument.ts, preloaded with node --import). Empty = off, which is
# right for the laptop; live, the DSN of the Node.js project in Sentry, set only in Render.
SENTRY_DSN=
# live on Render by itself (Render sets RENDER=true), development elsewhere; set it to override
SENTRY_ENVIRONMENT=

# The keys without a default, for the laptop (npm run infra:up); the other keys and their meaning are
# in backend/<name>/.env.example. The URLs of the internal deployables come from the bundle itself.
CORE__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
CORE__REDIS_URL=redis://localhost:6379
GATEWAY__REDIS_URL=redis://localhost:6379
# laptop only (public value; live has its own, ARCHITECTURE §7.2): the dev servers send it by default
GATEWAY__ORIGIN_SECRETS=not-a-secret-not-a-secret-not-a-secret
GATEWAY__APP_HOSTS=customer=localhost:3001,seller=localhost:3002,admin=localhost:3003,superadmin=localhost:3004,master=localhost:3005,support=localhost:3006,finance=localhost:3007,logistics=localhost:3008,delivery=localhost:3009,growth=localhost:3010,creator=localhost:3011
