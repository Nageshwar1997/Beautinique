{
  "name": "bundle",
  "version": "0.0.0",
  "private": true,
  "description": "Runs every deployable in one Node process (bundle mode, the Render live server).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --conditions=beautinique-source --import ./src/instrument.ts --watch src/start.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps --max-old-space-size=300 --import ./dist/instrument.js dist/start.js",
    "release": "node --conditions=beautinique-source src/db-release.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@beautinique/backend-server-kit": "^1.0.0",
    "@beautinique/backend-server-release": "^1.0.0",
    "@beautinique/shared-zod": "^2.0.0",
    "core": "^0.0.0",
    "gateway": "^0.0.0",
    "identity": "^0.0.0"
  },
  "devDependencies": {
    "@beautinique/backend-server-mongo": "^1.0.0",
    "@beautinique/backend-server-queue": "^1.0.0",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
