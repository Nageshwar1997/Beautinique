# identity settings: IDENTITY__<SETTING>, namespaced so backend/bundle can run every deployable in one
# process (ARCHITECTURE §3). Only src/config.ts reads them.
#
# Three parts:
#   LOCAL       what identity alone needs on the laptop (npm run dev --workspace identity). Your
#               backend/identity/.env is this part: copy it. Public laptop values, never secrets.
#   OPTIONAL    settings with a default: set one only to change it.
#   PRODUCTION  dummy values (<...> = the real one). Live runs backend/bundle: the real values go in
#               Render and your private backend/bundle/.env.production, never here.

# ═══ LOCAL (your .env) ══════════════════════════════════════════════════════════════════════════
# MongoDB: the laptop's replica set (npm run infra:up)
IDENTITY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# Redis: the laptop's Valkey
IDENTITY__REDIS_URL=redis://localhost:6379
# Encryption (@beautinique/backend-server-crypto): field keys seal secrets (TOTP), the blind index key
# hashes sign-in codes and the per-email counters. Public laptop keys (32 bytes of 1s and of 2s).
IDENTITY__FIELD_KEYS=k1:AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
IDENTITY__BLIND_INDEX_KEY=b1:AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
# Seals the sign-in code in identity.otp.requested for notify: exactly the value of
# NOTIFY__OTP_EVENT_KEYS. Public laptop key (32 zero bytes).
IDENTITY__OTP_EVENT_KEYS=e1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ═══ OPTIONAL (defaults) ════════════════════════════════════════════════════════════════════════
# IDENTITY__PORT=8081
# IDENTITY__LOG_LEVEL=info                     fatal, error, warn, info, debug, trace or silent
# IDENTITY__MONGO_DB_NAME=bq_identity          identity's own database; no other deployable uses it
# IDENTITY__OUTBOX_RELAY=poll                  poll (Atlas free) or changestream (a replica set you run)
# IDENTITY__OTP_EMAIL_LIMIT_PER_HOUR=5         codes one email may get in an hour, resends included
# IDENTITY__LEGAL_VERSION=dummy-1              terms and privacy version a sign-up accepts (dummy legal)

# ═══ PRODUCTION (Render; dummy values) ══════════════════════════════════════════════════════════
# IDENTITY__MONGO_URI=mongodb+srv://bq-identity:<password>@<cluster-host>/?retryWrites=true&w=majority
#                                              (Atlas user bq-identity, readWrite on bq_identity only)
# IDENTITY__REDIS_URL=redis://<bq-live-kv-internal-host>:6379     (Render Key Value, internal URL)
# IDENTITY__FIELD_KEYS=k1:<random-32-bytes-base64>
# IDENTITY__BLIND_INDEX_KEY=b1:<another-random-32-bytes-base64>
# IDENTITY__OTP_EVENT_KEYS=e1:<random-32-bytes-base64>            (exactly the same as NOTIFY__OTP_EVENT_KEYS)
#   make a key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
