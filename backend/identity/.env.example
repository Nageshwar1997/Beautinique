# identity settings: IDENTITY__<SETTING>, namespaced so backend/bundle can run every deployable in
# one process (ARCHITECTURE §3). Laptop: copy this file to .env (never committed). Live runs these
# keys in backend/bundle: their live values go in Render and in your private backend/bundle/.env.production.
IDENTITY__PORT=8081
# fatal, error, warn, info, debug, trace or silent
IDENTITY__LOG_LEVEL=info
# MongoDB: the laptop's replica set (npm run infra:up). Live: the Atlas connection string of the
# bq-identity database user (readWrite on bq_identity only).
IDENTITY__MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# identity's own database; no other deployable reads or writes it
IDENTITY__MONGO_DB_NAME=bq_identity
# Redis: Docker Valkey on the laptop. Live: Render Key Value, internal URL only.
IDENTITY__REDIS_URL=redis://localhost:6379
