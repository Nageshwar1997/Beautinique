# Customer app. Same three files as the backend:
#   .env.example     this file, in git: the laptop's values and what live needs. No secret, ever.
#   .env             your laptop: the dev server's /api proxy needs both keys (vite.config.ts) and stops
#                    with an error without them. Copy this file. Builds (Vercel, lint) need no .env.
#   .env.production  your private copy of the live values you set in Vercel (Production and Preview).
#                    Never committed, and nothing reads it: vercel.json takes both keys from Vercel's env.
# Keys without a VITE_ prefix never reach the browser bundle.

# The origin secret /api sends. Laptop: the public value the local gateway accepts
# (GATEWAY__ORIGIN_SECRETS in backend/bundle/.env.example). Live: the same secret as
# GATEWAY__ORIGIN_SECRETS in Render, in Vercel as Sensitive; vercel.json sets it as the x-origin-secret
# header (ARCHITECTURE §7.2).
ORIGIN_SECRET=not-a-secret-not-a-secret-not-a-secret

# Where /api goes. Laptop: the local gateway (npm run dev:backend). Live: https://bq-live.onrender.com
# (no trailing slash). The laptop cannot use the live one: the live gateway answers only the apps'
# Vercel hosts.
BQ_GATEWAY_URL=http://localhost:8080
